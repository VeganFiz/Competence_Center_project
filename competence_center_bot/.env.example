# Токен от @BotFather
BOT_TOKEN=123456:ABC...
# Telegram ID администратора или группы (узнать: написать боту @userinfobot)
ADMIN_CHAT_ID=0
DB_PATH=bookings.db
# FastAPI
API_HOST=127.0.0.1
API_PORT=8000
# Ключ для просмотра заявок через GET /api/requests (оставьте пустым, чтобы отключить)
API_KEY=
# Домены сайта для CORS через запятую (например https://example.kz). Пусто = отключено
ALLOWED_ORIGINS=
